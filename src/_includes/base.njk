<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description }}">
    <link rel="icon" type="image/svg+xml" href="{{ '/images/favicon.svg' | url }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ '/images/favicon-32x32.png' | url }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ '/images/favicon-16x16.png' | url }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ '/images/apple-touch-icon.png' | url }}">
    <link rel="manifest" href="{{ '/manifest.json' | url }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="{{ '/css/styles.css' | url }}">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Amir Mano",
      "url": "{{ site.url }}/",
      "jobTitle": "PhD Candidate in Computational Neuroscience",
      "affiliation": {
        "@type": "Organization",
        "name": "Tel Aviv University",
        "url": "https://www.tau.ac.il/"
      },
      "sameAs": [
        "https://www.linkedin.com/in/amirmano/",
        "https://linktr.ee/amirmano",
        "https://instagram.com/amirmano14",
        "https://www.facebook.com/amir.mano.7/",
        "https://x.com/AmirMano_",
        "https://bsky.app/profile/amirmano.bsky.social",
        "https://www.duolingo.com/profile/amirmano"
      ]
    }
    </script>
</head>

<body id="top">

    <header>
        <h1>Amir Mano</h1>
        <p class="header-tagline">
            <span>Neuroscientist &amp; Musician</span>
            <span>Studying how music changes the brain</span>
            <span>PhD Candidate in Computational Neuroscience · Tel Aviv University</span>
        </p>
    </header>

    <nav role="navigation">
        <button type="button" class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false"
            aria-controls="primary-nav">
            <span></span><span></span><span></span>
        </button>
        <ul class="nav-list" id="primary-nav">
            <li><a href="{{ '/' | url }}"{% if nav == "home" %} class="active" aria-current="page"{% endif %}>Home</a></li>
            <li><a href="{{ '/research/' | url }}"{% if nav == "research" %} class="active" aria-current="page"{% endif %}>Research</a></li>
            <li><a href="{{ '/music/' | url }}"{% if nav == "music" %} class="active" aria-current="page"{% endif %}>Music</a></li>
            <li><a href="{{ '/cv/' | url }}"{% if nav == "cv" %} class="active" aria-current="page"{% endif %}>CV</a></li>
            <li><a href="{{ '/contact/' | url }}"{% if nav == "contact" %} class="active" aria-current="page"{% endif %}>Contact</a></li>
        </ul>
    </nav>

    <main>
        {{ content | safe }}
    </main>

    <footer>
        <p>&copy; {% year %} Amir Mano | All Rights Reserved</p>
        <a href="#top" class="back-to-top">Back to Top</a>
    </footer>

    <div class="lightbox" hidden>
        <button type="button" class="lightbox-close" aria-label="Close image preview">&times;</button>
        <img src="" alt="">
    </div>

    <script src="{{ '/js/main.js' | url }}" defer></script>
</body>

</html>
